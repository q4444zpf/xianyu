# ===== 闲鱼监控配置 =====
# 搜索关键词（默认：像章）
KEYWORD=像章

# 轮询间隔（秒），不要小于 300，避免触发风控
INTERVAL_SECONDS=600

# 每次抓取的最大商品数
PAGE_LIMIT=30

# 是否使用无头模式（true / false），调试时可设为 false
HEADLESS=true

# 首轮是否发送邮件（true 表示首次启动也把已有列表发出来；
# false 表示首次启动只入库不发邮件，后续仅推送新增）
NOTIFY_ON_FIRST_RUN=false

# 登录失效提醒邮件冷却（秒），默认 21600=6 小时；设为 0 则每次失败都发
LOGIN_REMINDER_COOLDOWN_SECONDS=21600

# 单封邮件最多展示的新增商品条数（超出部分记入库为未通知，下轮继续发）
EMAIL_MAX_ITEMS=30

# ===== 邮箱（QQ 邮箱）配置 =====
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_account@qq.com
# QQ 邮箱授权码（不是 QQ 登录密码，需在 QQ 邮箱设置中开启 SMTP 后获取 16 位授权码）
SMTP_PASS=your_qq_smtp_authorization_code
MAIL_FROM=your_qq_account@qq.com
# 收件人，多个用英文逗号分隔
MAIL_TO=your_qq_account@qq.com
